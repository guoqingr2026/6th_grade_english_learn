# Copy to /etc/pep6-english/env on ECS
PEP6_AUTH_REQUIRED=1
PEP6_AUTH_ALLOW_LOCAL=0
PEP6_TOKEN_TTL=604800
PEP6_PORT=8080

# Default admin (created on first deploy by bootstrap_ecs.py)
PEP6_ADMIN_USER=admin
PEP6_ADMIN_PIN=admin@123

# Subfolder on existing site (leave empty for root). Example: /english
PEP6_WEB_PATH=/english
PEP6_NGINX_MODE=subpath
